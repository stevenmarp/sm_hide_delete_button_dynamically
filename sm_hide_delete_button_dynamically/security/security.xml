<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sm_hide_delete" model="ir.module.category">
        <field name="name">Hide Delete Button</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_sm_hide_delete" model="res.groups.privilege">
        <field name="name">Hide Delete Button</field>
        <field name="category_id" ref="module_category_sm_hide_delete"/>
    </record>

    <record id="group_sm_hide_delete_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_sm_hide_delete"/>
    </record>

    <record id="group_sm_hide_delete_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_sm_hide_delete"/>
        <field name="implied_ids" eval="[(4, ref('group_sm_hide_delete_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sm_hide_delete_manager'))]"/>
    </record>
</odoo>
