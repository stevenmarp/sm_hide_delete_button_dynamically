<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sm_hide_delete_rule_list" model="ir.ui.view">
        <field name="name">sm.hide.delete.rule.list</field>
        <field name="model">sm.hide.delete.rule</field>
        <field name="arch" type="xml">
            <list string="Hide Delete Rules">
                <field name="model_id"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sm_hide_delete_rule_form" model="ir.ui.view">
        <field name="name">sm.hide.delete.rule.form</field>
        <field name="model">sm.hide.delete.rule</field>
        <field name="arch" type="xml">
            <form string="Hide Delete Rule">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Visibility Rule">
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="notes" placeholder="Optional internal note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sm_hide_delete_rule_search" model="ir.ui.view">
        <field name="name">sm.hide.delete.rule.search</field>
        <field name="model">sm.hide.delete.rule</field>
        <field name="arch" type="xml">
            <search string="Hide Delete Rules">
                <field name="model_id"/>
                <field name="group_ids"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sm_hide_delete_rule" model="ir.actions.act_window">
        <field name="name">Hide Delete Rules</field>
        <field name="res_model">sm.hide.delete.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a rule to hide Delete action for a model.</p>
        </field>
    </record>
</odoo>
